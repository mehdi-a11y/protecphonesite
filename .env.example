# Copiez ce fichier en .env et renseignez vos identifiants.
# Le serveur (npm run server) utilisera ces variables.

# Base de données partagée (PostgreSQL). Sans cette variable, les données sont en mémoire (perdues au redémarrage).
# Format : postgres://USER:MOT_DE_PASSE@HOST:PORT/NOM_BDD
# Exemple local : postgres://postgres:monmotdepasse@localhost:5432/protecphone

# DATABASE_URL=

YALIDINE_API_ID=
YALIDINE_API_TOKEN=

# WhatsApp : envoi automatique d’un message de confirmation au client après chaque commande (via Twilio).
# Créez un compte sur twilio.com, activez WhatsApp (Sandbox pour test ou numéro WhatsApp Business).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM : une seule valeur. Sandbox (test) OU numéro Algérie (prod), pas les deux.
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# OU en prod avec ton numéro WhatsApp Business : TWILIO_WHATSAPP_FROM=whatsapp:+213XXXXXXXXX
# Template (recommandé pour messages business) : voir docs/WHATSAPP_TWILIO.md pour créer le template.
# TWILIO_WHATSAPP_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optionnel : clé secrète pour la validation du webhook (crc_token). Si vide, utilise YALIDINE_API_TOKEN.
# YALIDINE_WEBHOOK_SECRET=
# Si la validation échoue, essayer avec l'API ID comme secret : YALIDINE_WEBHOOK_USE_API_ID=true

# Optionnel : port du serveur proxy (défaut 3001)
# PORT=3001

# Email : notification aux confirmateurs à chaque nouvelle commande.
# --- Option 1 : Resend (recommandé sur Render, pas de blocage SMTP) ---
# Créer un compte sur resend.com, récupérer une clé API, optionnel : vérifier un domaine.
# RESEND_API_KEY=re_xxxx
# RESEND_FROM=ProtecPhone <onboarding@resend.dev>   (ou ton email vérifié)
# --- Option 2 : SMTP (Gmail, etc. — souvent bloqué sur hébergement gratuit) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votre@gmail.com
# SMTP_PASS=mot_de_passe_application_16_caracteres
# CONFIRMATEUR_EMAILS= (optionnel, défaut : brahimbouhounali2004@gmail.com, nacermido68@gmail.com)

# --- Variables pour le build frontend (Vite) ---
# Facebook / Meta Pixel (pour Facebook Ads). Si défini, le pixel sera chargé et les événements envoyés (PageView, ViewContent, AddToCart, InitiateCheckout, Purchase).
# Récupérez l’ID dans Facebook Business Suite → Paramètres du site → Données → Pixels.
# VITE_FB_PIXEL_ID=

# TikTok Pixel (pour TikTok Ads). Si défini, le pixel sera chargé et les événements envoyés (PageView, ViewContent, AddToCart, InitiateCheckout, CompletePayment).
# Récupérez l'ID dans TikTok Ads Manager → Assets → Events → Gérer → Code du pixel.
# VITE_TIKTOK_PIXEL_ID=
